:     RFDETRLargeConfig,\nL27:     RFDETRLargeDeprecatedConfig,\nL28:     RFDETRMediumConfig,\nL29:     RFDETRNanoConfig,\nL30:     RFDETRSeg2XLargeConfig,\nL31:     RFDETRSegLargeConfig,\nL32:     RFDETRSegMediumConfig,\nL33:     RFDETRSegNanoConfig,\nL34:     RFDETRSegPreviewConfig,\nL35:     RFDETRSegSmallConfig,\nL36:     RFDETRSegXLargeConfig,\nL37:     RFDETRSmallConfig,\nL38:     SegmentationTrainConfig,\nL39:     TrainConfig,\nL40: )\nL41: from rfdetr.main import Model, download_pretrain_weights\nL42: from rfdetr.util.coco_classes import COCO_CLASSES\nL43: from rfdetr.util.metrics import MetricsPlotSink, MetricsTensorBoardSink, MetricsWandBSink\nL44: logger = getLogger(__name__)\nL45: class RFDETR:\nL46:     \"\"\"\nL47:     The base RF-DETR class implements the core methods for training RF-DETR models,\nL48:     running inference on the models, optimising models, and uploading trained\nL49:     models for deployment.\nL50:     \"\"\"\nL51:     means = [0.485, 0.456, 0.406]\nL52:     stds = [0.229, 0.224, 0.225]\nL53:     size = None\nL54:     def __init__(self, **kwargs):\nL55:         self.model_config = self.get_model_config(**kwargs)\nL56:         self.maybe_download_pretrain_weights()\nL57:         self.model = self.get_model(self.model_config)\nL58:         self.callbacks = defaultdict(list)\nL59:         self.model.inference_model = None\nL60:         self._is_optimized_for_inference = False\nL61:         self._has_warned_about_not_being_optimized_for_inference = False\nL62:         self._optimized_has_been_compiled = False\nL63:         self._optimized_batch_size = None\nL64:         self._optimized_resolution = None\nL65:         self._optimized_dtype = None\nL66:     def maybe_download_pretrain_weights(self):\nL67:         \"\"\"\nL68:         Download pre-trained weights if they are not already downloaded.\nL69:         \"\"\"\nL70:         download_pretrain_weights(self.model_config.pretrain_weights)\nL71: \nL72:     def get_model_config(self, **kwargs):\nL73:         \"\"\"\nL74:         Retrieve the configuration parameters used by the model.\nL75:         \"\"\"\nL76:         return ModelConfig(**kwargs)\nL77:     def train(self, **kwargs):\nL78:         \"\"\"\nL79:         Train an RF-DETR model.\nL80:         \"\"\"\nL81:         config = self.get_train_config(**kwargs)\nL82:         self.train_from_config(config, **kwargs)\nL83: \nL84:     def optimize_for_inference(self, compile=True, batch_size=1, dtype=torch.float32):\nL85:         self.remove_optimized_model()\nL86: \nL87:         self.model.inference_model = deepcopy(self.model.model)\nL88:         self.model.inference_model.eval()\nL89:         self.model.inference_model.export()\nL90:         self._optimized_resolution = self.model.resolution\nL91:         self._is_optimized_for_inference = True\nL92: \nL93:         self.model.inference_model = self.model.inference_model.to(dtype=dtype)\nL94:         self._optimized_dtype = dtype\nL95:         if compile:\nL96:             self.model.inference_model = torch.jit.trace(\nL97:                 self.model.inference_model,\nL98:                 torch.randn(\nL99:                     batch_size, 3, self.model.resolution, self.model.resolution,\nL100:                     device=self.model.device,\nL101:                     dtype=dtype\nL102:                 )\nL103:             )\nL104:             self._optimized_has_been_compiled = True\nL105:             self._optimized_batch_size = batch_size\nL106:     def remove_optimized_model(self):\nL107:         self.model.inference_model = None\nL108:         self._is_optimized_for_inference = False\nL109:         self._optimized_has_been_compiled = False\nL110:         self._optimized_batch_size = None\nL111:         self._optimized_resolution = None\nL112:         self._optimized_half = False\nL113: \nL114:     def export(self, **kwargs):\nL115:         \"\"\"\nL116:         Export your model to an ONNX file.\nL117:         See [the ONNX export documentation](https://rfdetr.roboflow.com/learn/export/) for more information.\nL118:         \"\"\"\nL119:         self.model.export(**kwargs)\nL120:     @staticmethod\nL121:     def _load_classes(dataset_dir) -> List[str]:\nL122:         \"\"\"Load class names from a COCO or YOLO dataset directory.\"\"\"\nL123:         coco_path = os.path.join(dataset_dir, \"train\", \"_annotations.coco.json\")\nL124:         if os.path.exists(coco_path):\nL125:             with open(coco_path, \"r\") as f:\nL126:                 anns = json.load(f)\nL127:             class_names = [c[\"name\"] for c in anns[\"categories\"] if c[\"supercategory\"] != \"none\"]\nL128:             return class_names\nL129:         # list all YAML files in the folder\nL130:         yaml_paths = glob.glob(os.path.join(dataset_dir, \"*.yaml\")) + glob.glob(os.path.join(dataset_dir, \"*.yml\"))\nL131:         # any YAML file starting with data e.g. data.yaml, dataset.yaml\nL132:         yaml_data_files = [yp for yp in yaml_paths if os.path.basename(yp).startswith(\"data\")]\nL133:         if len(yaml_data_files) == 1:\nL134:             yaml_path = yaml_data_files[0]\nL135:             with open(yaml_path, \"r\") as f:\nL136:                 data = yaml.safe_load(f)\nL137:             if \"names\" in data:\nL138:                 if isinstance(data[\"names\"], dict):\nL139:                     return [data[\"names\"][i] for i in sorted(data[\"names\"].keys())]\nL140:                 return data[\"names\"]\nL141:             else:\nL142:                 raise ValueError(f\"Found {yaml_path} but it does not contain 'names' field.\")\nL143:         elif len(yaml_data_files) > 1:\nL144:             raise ValueError(f\"Found multiple YAML files starting with 'data' in {dataset_dir}: {yaml_data_files}. \"\nL145:                              \"Please rename one of them to avoid conflicts.\")\nL146:         raise FileNotFoundError(\nL147:             f\"Could not find class names in {dataset_dir}. \"\nL148:             \"Checked for COCO (train/_annotations.coco.json) and YOLO (data.yaml, data.yml) styles.\"\nL149:         )\nL150:     def train_from_config(self, config: TrainConfig, **kwargs):\nL151:         if config.dataset_file == \"roboflow\":\nL152:             class_names = self._load_classes(config.dataset_dir)\nL153:             num_classes = len(class_names)\nL154:             self.model.class_names = class_names\nL155:         elif config.dataset_file == \"coco\":\nL156:             class_names = COCO_CLASSES\nL157:             num_classes = 90\nL158:         else:\nL159:             raise ValueError(f\"Invalid dataset file: {config.dataset_file}\")\nL160:         if self.model_config.num_classes != num_classes:\nL161:             self.model.reinitialize_detection_head(num_classes)\nL162: \nL163:         train_config = config.dict()\nL164:         model_config = self.model_config.dict()\nL165:         model_config.pop(\"num_classes\")\nL166:         if \"class_names\" in model_config:\nL167:             model_config.pop(\"class_names\")\nL168: \nL169:         if \"class_names\" in train_config and train_config[\"class_names\"] is None:\nL170:             train_config[\"class_names\"] = class_names\nL171:         for k, v in train_config.items():\nL172:             if k in model_config:\nL173:                 model_config.pop(k)\nL174:             if k in kwargs:\nL175:                 kwargs.pop(k)\nL176: \nL177:         all_kwargs = {**model_config, **train_config, **kwargs, \"num_classes\": num_classes}\nL178: \nL179:         metrics_plot_sink = MetricsPlotSink(output_dir=config.output_dir)\nL180:         self.callbacks[\"on_fit_epoch_end\"].append(metrics_plot_sink.update)\nL181:         self.callbacks[\"on_train_end\"].append(metrics_plot_sink.save)\nL182:         if config.tensorboard:\nL183:             metrics_tensor_board_sink = MetricsTensorBoardSink(output_dir=config.output_dir)\nL184:             self.callbacks[\"on_fit_epoch_end\"].append(metrics_tensor_board_sink.update)\nL185:             self.callbacks[\"on_train_end\"].append(metrics_tensor_board_sink.close)\nL186:         if config.wandb:\nL187:             metrics_wandb_sink = MetricsWandBSink(\nL188:                 output_dir=config.output_dir,\nL189:                 project=config.project,\nL190:                 run=config.run,\nL191:                 config=config.model_dump()\nL192:             )\nL193:             self.callbacks[\"on_fit_epoch_end\"].append(metrics_wandb_sink.update)\nL194:             self.callbacks[\"on_train_end\"].append(metrics_wandb_sink.close)\nL195:         if config.early_stopping:\nL196:             from rfdetr.util.early_stopping import EarlyStoppingCallback\nL197:             early_stopping_callback = EarlyStoppingCallback(\nL198:                 model=self.model,\nL199:                 patience=config.early_stopping_patience,\nL200:                 min_delta=config.early_stopping_min_delta,\nL201:                 use_ema=config.early_stopping_use_ema,\nL202:                 segmentation_head=config.segmentation_head\nL203:             )\nL204:             self.callbacks[\"on_fit_epoch_end\"].append(early_stopping_callback.update)\nL205:         self.model.train(\nL206:             **all_kwargs,\nL207:             callbacks=self.callbacks,\nL208:         )\nL209: \nL210:     def get_train_config(self, **kwargs):\nL211:         \"\"\"\nL212:         Retrieve the configuration parameters that will be used for training.\nL213:         \"\"\"\nL214:         return TrainConfig(**kwargs)\nL215: \nL216:     def get_model(self, config: ModelConfig):\nL217:         \"\"\"\nL218:         Retrieve a model instance based on the provided configuration.\nL219:         \"\"\"\nL220:         return Model(**config.dict())\nL221:     # Get class_names from the model\nL222:     @property\nL223:     def class_names(self):\nL224:         \"\"\"\nL225:         Retrieve the class names supported by the loaded model.\nL226: \nL227:         Returns:\nL228:             dict: A dictionary mapping class IDs to class names. The keys are integers starting from\nL229:         \"\"\"\nL230:         if hasattr(self.model, 'class_names') and self.model.class_names:\nL231:             return {i+1: name for i, name in enumerate(self.model.class_names)}\nL232: \nL233:         return COCO_CLASSES\nL234:     def predict(\nL235:         self,\nL236:         images: Union[str, Image.Image, np.ndarray, torch.Tensor, List[Union[str, np.ndarray, Image.Image, torch.Tensor]]],\nL237:         threshold: float = 0.5,\nL238:         **kwargs,\nL239:     ) -> Union[sv.Detections, List[sv.Detections]]:\nL240:         \"\"\"Performs object detection on the input images and returns bounding box\nL241:         predictions.\nL242:         This method accepts a single image or a list of images in various formats\nL243:         (file path, PIL Image, NumPy array, or torch.Tensor). The images should be in\nL244:         RGB channel order. If a torch.Tensor is provided, it must already be normalized\nL245:         to values in the [0, 1] range and have the shape (C, H, W).\nL246:         Args:\nL247:             images (Union[str, Image.Image, np.ndarray, torch.Tensor, List[Union[str, np.ndarray, Image.Image, torch.Tensor]]]):\nL248:                 A single image or a list of images to process. Images can be provided\nL249:                 as file paths, PIL Images, NumPy arrays, or torch.Tensors.\nL250:             threshold (float, optional):\nL251:                 The minimum confidence score needed to consider a detected bounding box valid.\nL252:             **kwargs:\nL253:                 Additional keyword arguments.\nL254:         Returns:\nL255:             Union[sv.Detections, List[sv.Detections]]: A single or multiple Detections\nL256:                 objects, each containing bounding box coordinates, confidence scores,\nL257:                 and class IDs.\nL258:         \"\"\"\nL259:         if not self._is_optimized_for_inference and not self._has_warned_about_not_being_optimized_for_inference:\nL260:             logger.warning(\nL261:                 \"Model is not optimized for inference. \"\nL262:                 \"Latency may be higher than expected. \"\nL263:                 \"You can optimize the model for inference by calling model.optimize_for_inference().\"\nL264:             )\nL265:             self._has_warned_about_not_being_optimized_for_inference = True\nL266:             self.model.model.eval()\nL267: \nL268:         if not isinstance(images, list):\nL269:             images = [images]\nL270: \nL271:         orig_sizes = []\nL272:         processed_images = []\nL273: \nL274:         for img in images:\nL275: \nL276:             if isinstance(img, str):\nL277:                 img = Image.open(img)\nL278: \nL279:             if not isinstance(img, torch.Tensor):\nL280:                 img = F.to_tensor(img)\nL281:             if (img > 1).any():\nL282:                 raise ValueError(\nL283:                     \"Image has pixel values above 1. Please ensure the image is \"\nL284:                     \"normalized (scaled to [0, 1]).\"\nL285:                 )\nL286:             if img.shape[0] != 3:\nL287:                 raise ValueError(\nL288:                     f\"Invalid image shape. Expected 3 channels (RGB), but got \"\nL289:                     f\"{img.shape[0]} channels.\"\nL290:                 )\nL291:             img_tensor = img\nL292:             h, w = img_tensor.shape[1:]\nL293:             orig_sizes.append((h, w))\nL294: \nL295:             img_tensor = img_tensor.to(self.model.device)\nL296:             img_tensor = F.normalize(img_tensor, self.means, self.stds)\nL297:             img_tensor = F.resize(img_tensor, (self.model.resolution, self.model.resolution))\nL298: \nL299:             processed_images.append(img_tensor)\nL300: \nL301:         batch_tensor = torch.stack(processed_images)\nL302:         if self._is_optimized_for_inference:\nL303:             if self._optimized_resolution != batch_tensor.shape[2]:\nL304:                 # this could happen if someone manually changes self.model.resolution after optimizing the model\nL305:                 raise ValueError(f\"Resolution mismatch. \"\nL306:                                  f\"Model was optimized for resolution {self._optimized_resolution}, \"\nL307:                                  f\"but got {batch_tensor.shape[2]}. \"\nL308:                                  \"You can explicitly remove the optimized model by calling model.remove_optimized_model().\")\nL309:             if self._optimized_has_been_compiled:\nL310:                 if self._optimized_batch_size != batch_tensor.shape[0]:\nL311:                     raise ValueError(f\"Batch size mismatch. \"\nL312:                                      f\"Optimized model was compiled for batch size {self._optimized_batch_size}, \"\nL313:                                      f\"but got {batch_tensor.shape[0]}. \"\nL314:                                      \"You can explicitly remove the optimized model by calling model.remove_optimized_model(). \"\nL315:                                      \"Alternatively, you can recompile the optimized model for a different batch size \"\nL316:                                      \"by calling model.optimize_for_inference(batch_size=<new_batch_size>).\")\nL317:         with torch.no_grad():\nL318:             if self._is_optimized_for_inference:\nL319:                 predictions = self.model.inference_model(batch_tensor.to(dtype=self._optimized_dtype))\nL320:             else:\nL321:                 predictions = self.model.model(batch_tensor)\nL322:             if isinstance(predictions, tuple):\nL323:                 return_predictions = {\nL324:                     \"pred_logits\": predictions[1],\nL325:                     \"pred_boxes\": predictions[0],\nL326:                 }\nL327:                 if len(predictions) == 3:\nL328:                     return_predictions[\"pred_masks\"] = predictions[2]\nL329:                 predictions = return_predictions\nL330:             target_sizes = torch.tensor(orig_sizes, device=self.model.device)\nL331:             results = self.model.postprocess(predictions, target_sizes=target_sizes)\nL332:         detections_list = []\nL333:         for result in results:\nL334:             scores = result[\"scores\"]\nL335:             labels = result[\"labels\"]\nL336:             boxes = result[\"boxes\"]\nL337: \nL338:             keep = scores > threshold\nL339:             scores = scores[keep]\nL340:             labels = labels[keep]\nL341:             boxes = boxes[keep]\nL342: \nL343:             if \"masks\" in result:\nL344:                 masks = result[\"masks\"]\nL345:                 masks = masks[keep]\nL346:                 detections = sv.Detections(\nL347:                     xyxy=boxes.float().cpu().numpy(),\nL348:                     confidence=scores.float().cpu().numpy(),\nL349:                     class_id=labels.cpu().numpy(),\nL350:                     mask=masks.squeeze(1).cpu().numpy(),\nL351:                 )\nL352:             else:\nL353:                 detections = sv.Detections(\nL354:                     xyxy=boxes.float().cpu().numpy(),\nL355:                     confidence=scores.float().cpu().numpy(),\nL356:                     class_id=labels.cpu().numpy(),\nL357:                 )\nL358:             detections_list.append(detections)\nL359: \nL360:         return detections_list if len(detections_list) > 1 else detections_list[0]\nL361: \nL362:     def deploy_to_roboflow(self, workspace: str, project_id: str, version: str, api_key: str = None, size: str = None):\nL363:         \"\"\"\nL364:         Deploy the trained RF-DETR model to Roboflow.\nL365: \nL366:         Deploying with Roboflow will create a Serverless API to which you can make requests.\nL367:         You can also download weights into a Roboflow Inference deployment for use in Roboflow Workflo
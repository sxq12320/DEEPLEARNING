box_y2), (0, 255, 0), 2)\nL70:             cv2.imshow('image', img)\nL71:             cv2.waitKey(0)\nL72:             cv2.destroyAllWindows()\nL73: def show_detection(gt,detection,img_path):\nL74:     \"\"\"\nL75:     :param gt: ground truth data\nL76:     :param proposal: cluster proposals data\nL77:     :return:\nL78:     \"\"\"\nL79:     det_bboxes_scores_all=detection['all_boxes'][1]\nL80:     img_inf=gt['images']\nL81:     for i in range(len(det_bboxes_scores_all)):\nL82:         det_bboxes_scores=det_bboxes_scores_all[i][:,:5]\nL83:         det_scores = det_bboxes_scores_all[i][:,4]\nL84:         if len(det_scores)>0:\nL85:             img_name=img_inf[i]['file_name']\nL86:             img_file=os.path.join(img_path,img_name)\nL87:             img = cv2.imread(img_file)\nL88:             # draw bbox on image\nL89:             det_bboxes_scores=det_bboxes_scores[det_scores>0.3,:]\nL90:             det_bboxes_scores = ICM(det_bboxes_scores, 0.5, 3)\nL91:             # det_bboxes_scores = NMM(det_bboxes_scores, 0.7)\nL92:             # det_bboxes = NMM(det_bboxes, 0.7)\nL93:             for bbox_i, bbox in enumerate(det_bboxes_scores):\nL94:                 bbox_x1 = int(bbox[0])\nL95:                 bbox_y1 = int(bbox[1])\nL96:                 bbox_x2 = int(bbox[2])\nL97:                 bbox_y2 = int(bbox[3])\nL98:                 cv2.rectangle(img, (bbox_x1, bbox_y1), (bbox_x2, bbox_y2), (0, 255, 0), 2)\nL99:             cv2.imshow('image', img)\nL100: \nL101:             cv2.waitKey(0)\nL102:             cv2.destroyAllWindows()\nL103: \nL104: def NMS(boxes,iouthreshold):\nL105:     # if there are no boxes, return an empty list\nL106:     if len(boxes) == 0:\nL107:         return []\nL108: \nL109:     # if the bounding boxes integers, convert them to floats --\nL110:     # this is important since we'll be doing a bunch of divisions\nL111:     if boxes.dtype.kind == \"i\":\nL112:         boxes = boxes.astype(\"float\")\nL113: \nL114:     # initialize the list of picked indexes\nL115:     pick = []\nL116:     # grab the coordinates of the bounding boxes\nL117:     x1 = boxes[:, 0]\nL118:     y1 = boxes[:, 1]\nL119:     x2 = boxes[:, 2]\nL120:     y2 = boxes[:, 3]\nL121: \nL122:     # compute the area of the bounding boxes and sort the bounding\nL123:     # boxes by the bottom-right y-coordinate of the bounding box\nL124:     area = (x2 - x1 + 1) * (y2 - y1 + 1)\nL125:     idxs = range(len(area))#np.argsort(y2)\nL126:     idxs.reverse()\nL127:     # keep looping while some indexes still remain in the indexes\nL128:     # list\nL129:     while len(idxs) > 0:\nL130:         # grab the last index in the indexes list and add the\nL131:         # index value to the list of picked indexes\nL132:         last = len(idxs) - 1\nL133:         i = idxs[last]\nL134:         pick.append(i)\nL135:         # find the largest (x, y) coordinates for the start of\nL136:         # the bounding box and the smallest (x, y) coordinates\nL137:         # for the end of the bounding box\nL138:         xx1 = np.maximum(x1[i], x1[idxs[:last]])\nL139:         yy1 = np.maximum(y1[i], y1[idxs[:last]])\nL140:         xx2 = np.minimum(x2[i], x2[idxs[:last]])\nL141:         yy2 = np.minimum(y2[i], y2[idxs[:last]])\nL142: \nL143:         # compute the width and height of the bounding box\nL144:         w = np.maximum(0, xx2 - xx1 + 1)\nL145:         h = np.maximum(0, yy2 - yy1 + 1)\nL146:         # compute the ratio of overlap\nL147:         overlap = (w * h) / (area[idxs[:last]]+area[last]-w*h)\nL148: \nL149: \nL150:         # delete all indexes from the index list that have\nL151:         delete_idxs = np.concatenate(([last],\nL152:                                       np.where(overlap > iouthreshold)[0]))\nL153:         idxs = np.delete(idxs, delete_idxs)\nL154: \nL155: \nL156:     # return only the bounding boxes that were picked using the\nL157:     # integer data type\nL158:     return boxes[pick].astype(\"int\")\nL159: def crop_cluster_meanshift(gt_file_list,img_path,gt_save_path,img_save_path):\nL160:     \"\"\"\nL161:     crop the clustered regions generated by meanshift\nL162:     \"\"\"\nL163:     if not os.path.exists(gt_save_path):\nL164:         os.mkdir(gt_save_path)\nL165:     if not os.path.exists(img_save_path):\nL166:         os.mkdir(img_save_path)\nL167: \nL168: \nL169:     for i,gt_file in enumerate(gt_file_list):\nL170:         print(gt_file)\nL171:         gt=np.loadtxt(gt_file, delimiter=',')\nL172:         gt=gt.astype(np.int)\nL173:         if len(gt.shape)==1:\nL174:             continue\nL175:         object_gt_inds=np.where((gt[:,5]<11) & (gt[:,4]==1))[0]\nL176:         object_gt=gt[object_gt_inds,:]\nL177:         cluster_gt_inds = np.where(gt[:,5] == 11)[0]\nL178:         cluster_gt=gt[cluster_gt_inds,:]\nL179:         # get cluster bounding box [x1,y1,x2,y2]\nL180:         img_name=os.path.splitext(os.path.basename(gt_file))[0]\nL181:         img_file=os.path.join(img_path, img_name+'.jpg')\nL182:         img = cv2.imread(img_file)\nL183:         cluster_x1=cluster_gt[:,0]\nL184:         cluster_y1 =cluster_gt[:,1]\nL185:         cluster_x2 =cluster_gt[:,0]+cluster_gt[:,2]-1\nL186:         cluster_y2 =cluster_gt[:,1]+cluster_gt[:,3]-1\nL187:         cluster_num=len(cluster_gt[:,0])\nL188:         if 1:\nL189:             # show cluster on raw image\nL190:             for cluster_i in range(cluster_num):\nL191:                 cv2.rectangle(img, (cluster_x1[cluster_i], cluster_y1[cluster_i]), (cluster_x2[cluster_i], cluster_y2[cluster_i]), (0, 255, 0), 2)\nL192:             cv2.imshow('image', img)\nL193:             cv2.waitKey(0)\nL194:             cv2.destroyAllWindows()\nL195:         # get the center point of the objects\nL196:         obj_x1=object_gt[:,0]\nL197:         obj_y1 = object_gt[:, 1]\nL198:         obj_w = object_gt[:, 2]\nL199:         obj_h = object_gt[:, 3]\nL200:         obj_x2 = obj_x1+obj_w-1\nL201:         obj_y2 = obj_y1+obj_h-1\nL202:         obj_center_x=obj_x1+obj_w/2-1\nL203:         obj_center_x=obj_center_x.astype(np.int)\nL204:         obj_center_y = obj_y1 + obj_h/2-1\nL205:         obj_center_y=obj_center_y.astype(np.int)\nL206:         obj_score=object_gt[:,4]\nL207:         obj_cls = object_gt[:, 5]\nL208:         obj_truncation=object_gt[:,6]\nL209:         obj_occlusion = object_gt[:, 7]\nL210:         # crop cluster regions\nL211:         for cluster_i in range(cluster_num):\nL212:             cluster_i_x1 = cluster_x1[cluster_i]\nL213:             cluster_i_y1 = cluster_y1[cluster_i]\nL214:             cluster_i_x2 = cluster_x2[cluster_i]\nL215:             cluster_i_y2 = cluster_y2[cluster_i]\nL216:             cluster_i_w=cluster_i_x2-cluster_i_x1+1\nL217:             cluster_i_h=cluster_i_y2-cluster_i_y1+1\nL218:             obj_ids_in_cluster_i=np.where((obj_center_x<cluster_i_x2) & (obj_center_x>cluster_i_x1)\nL219:                      & (obj_center_y<cluster_i_y2) & (obj_center_y>cluster_i_y1))[0]\nL220:             obj_num_in_cluster_i=len(obj_ids_in_cluster_i)\nL221:             if obj_num_in_cluster_i>3:\nL222: \nL223:                 img_cluster_region=img[cluster_y1[cluster_i]:cluster_y2[cluster_i], cluster_x1[cluster_i]:cluster_x2[cluster_i]]\nL224:                 # show cropped cluster region\nL225:                 if 1:\nL226:                     cv2.imshow('image_cluster_region', img_cluster_region)\nL227:                     cv2.waitKey(0)\nL228:                     cv2.destroyAllWindows()\nL229:                 # get the object location [x1,y1,w,h] in cluster region\nL230:                 obj_x1_cluster_i = np.maximum(obj_x1[obj_ids_in_cluster_i] - cluster_i_x1,0)\nL231:                 obj_y1_cluster_i = np.maximum(obj_y1[obj_ids_in_cluster_i] - cluster_i_y1,0)\nL232:                 obj_x2_cluster_i = np.minimum(obj_x2[obj_ids_in_cluster_i] - cluster_i_x1,cluster_i_w)\nL233:                 obj_y2_cluster_i = np.minimum(obj_y2[obj_ids_in_cluster_i] - cluster_i_y1,cluster_i_h)\nL234:                 obj_w_cluster_i=obj_x2_cluster_i-obj_x1_cluster_i\nL235:                 obj_h_cluster_i = obj_y2_cluster_i - obj_y1_cluster_i\nL236:                 # show object in the cropped region\nL237:                 if 1:\nL238:                     for obj_i_in_cluster_i in range(obj_num_in_cluster_i):\nL239:                         cv2.rectangle(img_cluster_region, (obj_x1_cluster_i[obj_i_in_cluster_i], obj_y1_cluster_i[obj_i_in_cluster_i]),\nL240:                                       (obj_x2_cluster_i[obj_i_in_cluster_i], obj_y2_cluster_i[obj_i_in_cluster_i]), (0, 255, 0), 2)\nL241:                     cv2.imshow('image_cluster_region', img_cluster_region)\nL242:                     cv2.waitKey(0)\nL243:                     cv2.destroyAllWindows()\nL244:                 # save object information to text file\nL245:                 object_gt_in_cluster_i=object_gt[obj_ids_in_cluster_i,:]\nL246:                 object_gt_in_cluster_i[:,0]=obj_x1_cluster_i\nL247:                 object_gt_in_cluster_i[:, 1] = obj_y1_cluster_i\nL248:                 object_gt_in_cluster_i[:, 2] = obj_w_cluster_i\nL249:                 object_gt_in_cluster_i[:, 3] = obj_h_cluster_i\nL250:                 obj_inf=object_gt_in_cluster_i\nL251:                 cluster_gt_file=os.path.join(gt_save_path,img_name+'_{}.txt'.format(cluster_i))\nL252:                 np.savetxt(cluster_gt_file, obj_inf, fmt='%u',delimiter=',')\nL253:                 # save cropped cluster image\nL254:                 cluster_img_file=os.path.join(img_save_path,img_name+'_{}_meanshift.jpg'.format(cluster_i))\nL255:                 cv2.imwrite(cluster_img_file,img_cluster_region)\nL256: def crop_cluster_ClusterNet(cluster_det,gt,img_path,img_save_path,gt_save_path):\nL257:     \"\"\"\nL258:     crop the clustered regions generated by ClusterNet\nL259:     \"\"\"\nL260:     if not os.path.exists(gt_save_path):\nL261:         os.mkdir(gt_save_path)\nL262:     if not os.path.exists(img_save_path):\nL263:         os.mkdir(img_save_path)\nL264: \nL265:     det_bboxes_scores_all = cluster_det['all_boxes'][1]\nL266:     img_inf = gt['images']\nL267:     for i in range(len(det_bboxes_scores_all)):\nL268:         det_bboxes_scores = det_bboxes_scores_all[i][:, :5]\nL269:         det_scores = det_bboxes_scores_all[i][:, 4]\nL270:         if len(det_scores) > 0:\nL271:             img_name = img_inf[i]['file_name']\nL272:             img_file = os.path.join(img_path, img_name)\nL273:             img = cv2.imread(img_file)\nL274:             det_bboxes_scores = det_bboxes_scores[det_scores > 0.3, :]\nL275:             det_bboxes_scores = ICM(det_bboxes_scores, 0.7, 3)\nL276:             # draw bbox on image\nL277:             if 0:\nL278:                 for bbox_i, bbox in enumerate(det_bboxes_scores):\nL279:                     bbox_x1 = int(bbox[0])\nL280:                     bbox_y1 = int(bbox[1])\nL281:                     bbox_x2 = int(bbox[2])\nL282:                     bbox_y2 = int(bbox[3])\nL283:                     cv2.rectangle(img, (bbox_x1, bbox_y1), (bbox_x2, bbox_y2), (0, 255, 0), 2)\nL284:                 cv2.imshow('image', img)\nL285:                 cv2.waitKey(0)\nL286:                 cv2.destroyAllWindows()\nL287:             # crop cluster regions\nL288:             for bbox_i, bbox in enumerate(det_bboxes_scores):\nL289:                 bbox_x1 = int(bbox[0])\nL290:                 bbox_y1 = int(bbox[1])\nL291:                 bbox_x2 = int(bbox[2])\nL292:                 bbox_y2 = int(bbox[3])\nL293:                 img_cluster_region = img[bbox_y1:bbox_y2,\nL294:                                  bbox_x1:bbox_x2]\nL295:                 # show cropped cluster region\nL296:                 if 0:\nL297:                     cv2.imshow('image_cluster_region', img_cluster_region)\nL298:                     cv2.waitKey(0)\nL299:                     cv2.destroyAllWindows()\nL300:                 # save cropped cluster image\nL301:                 img_name=os.path.splitext(os.path.basename(img_name))[0]\nL302:                 cluster_img_file = os.path.join(img_save_path, img_name + '_{}_{}.jpg'.format(bbox_x1,bbox_y1))\nL303:                 cv2.imwrite(cluster_img_file, img_cluster_region)\nL304:                 # save object information to text file\nL305:                 obj_inf=np.array([[1,1,10,10,1,1,1,1],[1,1,10,10,1,1,1,1]]) # the valute do not have practical meanning\nL306:                 cluster_gt_file=os.path.join(gt_save_path,img_name+'_{}_{}.txt'.format(bbox_x1,bbox_y1))\nL307:                 np.savetxt(cluster_gt_file, obj_inf, fmt='%u',delimiter=',')\nL308: \nL309: if __name__ == \"__main__\":\nL310:     cluster_proposal_file='/media/fanyang/C/code/detector/Detectron-Cascade-RCNN/test/visdrone/coco_2014_val' \\\nL311:                           '/generalized_rcnn/detections.pkl'\nL312:     gt_file='/media/fanyang/C/data/visdrone/VisDrone2018-DET-val/coco_format_annotations/instances_val2014.json'\nL313:     img_path='/media/fanyang/C/data/visdrone/VisDrone2018-DET-val/images_coco_format_rename'\nL314:     gt_save_path='/media/fanyang/C/data/visdrone/VisDrone2018-DET-val/cluster_crop_gt_CPNet'\nL315:     img_save_path='/media/fanyang/C/data/visdrone/VisDrone2018-DET-val/cluster_crop_image_CPNet'\nL316:     # cluster_proposal=load_cluster_proposals(cluster_proposal_file)\nL317:     cluster_detection=load_cluster_detections(cluster_proposal_file)\nL318:     gt=load_gt(gt_file)\nL319:     crop_cluster_ClusterNet(cluster_detection,gt,img_path,img_save_path,gt_save_path)\n"

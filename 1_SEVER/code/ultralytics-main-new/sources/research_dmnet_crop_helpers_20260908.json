" (https://raw.githubusercontent.com/Cli98/DMNet/master/image%20cropping/density_slide_utils.py)\nciteturn192view0 [wordlim: 200] Crawled: 2 weeks ago; Content type: text/plain; Source: open({\"ref_id\":\"https://raw.githubusercontent.com/Cli98/DMNet/master/image%20cropping/density_slide_utils.py\",\"lineno\":null}); Total lines: 121\nL0: import cv2\nL1: import os\nL2: from anno_utils import format_label\nL3: from plot_utils import overlay_image\nL4: from tqdm import tqdm\nL5: \nL6: def split_overlay_map(grid):\nL7:     \"\"\"\nL8:     Conduct eight-connected-component methods on grid to connnect all pixel within the similar region\nL9:     :param grid: desnity mask to connect\nL10:     :return: merged regions for cropping purpose\nL11:     \"\"\"\nL12:     if grid is None or grid[0] is None:\nL13:         return 0\nL14:     # Assume overlap_map is a 2d feature map\nL15:     m, n = grid.shape\nL16:     visit = [[0 for _ in range(n)] for _ in range(m)]\nL17:     count, queue, result = 0, [], []\nL18:     for i in range(m):\nL19:         for j in range(n):\nL20:             if not visit[i][j]:\nL21:                 if grid[i][j] == 0:\nL22:                     visit[i][j] = 1\nL23:                     continue\nL24:                 queue.append([i, j])\nL25:                 top, left = float(\"inf\"), float(\"inf\")\nL26:                 bot, right = float(\"-inf\"), float(\"-inf\")\nL27:                 while queue:\nL28:                     i_cp, j_cp = queue.pop(0)\nL29:                     top = min(i_cp, top)\nL30:                     left = min(j_cp, left)\nL31:                     bot = max(i_cp, bot)\nL32:                     right = max(j_cp, right)\nL33:                     if 0 <= i_cp < m and 0 <= j_cp < n and not visit[i_cp][j_cp]:\nL34:                         visit[i_cp][j_cp] = 1\nL35:                         if grid[i_cp][j_cp] == 255:\nL36:                             queue.append([i_cp, j_cp + 1])\nL37:                             queue.append([i_cp + 1, j_cp])\nL38:                             queue.append([i_cp, j_cp - 1])\nL39:                             queue.append([i_cp - 1, j_cp])\nL40:                 count += 1\nL41:                 assert top < bot and left < right, \"Coordination error!\"\nL42:                 pixel_area = (right - left) * (bot - top)\nL43:                 result.append([count, (max(0, left), max(0, top)), (min(right, n), min(bot, m)), pixel_area])\nL44:                 # compute pixel area by split_coord\nL45:     return result\nL46: \nL47: def gather_split_result(img_path, result, output_img_dir,\nL48:                         output_anno_dir, mode=\"train\"):\nL49:     \"\"\"\nL50:     Collect split results after we run eight-connected-components\nL51:     We need to extract coord from merging step and output the cropped images together with their annotations\nL52:     to output image/anno dir\nL53:     :param img_path: The path for image to read-in\nL54:     :param result: merging result from eight-connected-component\nL55:     :param output_img_dir: the output dir to save image\nL56:     :param output_anno_dir: the output dir to save annotations\nL57:     :param mode: The dataset to process (Train/val/test)\nL58:     :return:\nL59:     \"\"\"\nL60:     # obtain output of both cropped image and cropped annotations\nL61:     if not os.path.exists(output_img_dir):\nL62:         os.makedirs(output_img_dir, exist_ok=False)\nL63:     if not os.path.exists(output_anno_dir):\nL64:         os.makedirs(output_anno_dir, exist_ok=False)\nL65:     img = cv2.imread(img_path)\nL66:     if mode != \"test-challenge\":\nL67:         # Please note that annotation here only for evaluation purpose, nothing to do with training\nL68:         # For test-challenge dataset we have no annotations, and thus we do not read ground truth\nL69:         anno_path = img_path.replace(\"images\", \"annotations\").replace(\"jpg\", \"txt\")\nL70:         txt_list = format_label(anno_path, mode)\nL71:     for count, top_left_coord, bot_right_coord, pixel_area in result:\nL72:         (left, top), (right, bot) = top_left_coord, bot_right_coord\nL73:         # left, top is the offset required\nL74:         cropped_image = img[top:bot, left:right]\nL75:         cropped_image_resolution = cropped_image.shape[0] * cropped_image.shape[1]\nL76:         if cropped_image.shape[0] == 0 or cropped_image.shape[1] == 0 or cropped_image_resolution < 70 * 70:\nL77:             continue\nL78:         # we expect no images gathered with zero height/width\nL79:         assert cropped_image.shape[0] > 0 and cropped_image.shape[1] > 0, str(top) + \" \" + str(bot) + \" \" + str(\nL80:             left) + \" \" + str(right)\nL81:         if mode != \"test-challenge\":\nL82:             # If we have ground truth, generate them as txt file. This can be further used as annotations for gt generation\nL83:             with open(os.path.join(output_anno_dir, str(top) + \"_\" + str(left) + \"_\" + str(bot) + \"_\" + str(right) + \"_\"\nL84:                                                     + img_path.split(r\"/\")[-1].replace(\"jpg\", \"txt\")),\nL85:                       'w') as filerecorder:\nL86:                 for bbox_left, bbox_top, bbox_right, bbox_bottom, raw_coord in txt_list:\nL87:                     if left <= bbox_left and right >= bbox_right and top <= bbox_top and bot >= bbox_bottom:\nL88:                         raw_coord = raw_coord.split(\",\")\nL89:                         raw_coord[0], raw_coord[1] = str(int(raw_coord[0]) - left), str(int(raw_coord[1]) - top)\nL90:                         raw_coord = \",\".join(raw_coord)\nL91:                         filerecorder.write(raw_coord)\nL92:         # If no ground truth available, then we only export images\nL93:         status = cv2.imwrite(\nL94:             os.path.join(output_img_dir, str(top) + \"_\" + str(left) + \"_\" + str(bot) + \"_\" + str(right) + \"_\"\nL95:                          + img_path.split(\"/\")[-1]), cropped_image)\nL96:         if not status:\nL97:             # Check if images have been saved properly\nL98:             print(\"Failed to save image!\")\nL99:             exit()\nL100:     return\nL101: \nL102: def save_cropped_result(img_array, window_size, threshold, output_dens_dir,\nL103:                         output_img_dir, output_anno_dir, mode=\"train\"):\nL104:     \"\"\"\nL105:     A wrapper to conduct all necessary operation for generating density crops\nL106:     :param img_array: The input image to crop on\nL107:     :param window_size: The kernel selected to slide on images to gather crops\nL108:     :param threshold: determine if the crops are ROI, only crop when total pixel sum exceeds threshold\nL109:     :param output_dens_dir: The output dir to save density map\nL110:     :param output_img_dir: The output dir to save images\nL111:     :param output_anno_dir: The output dir to save annotations\nL112:     :param mode: The dataset to operate on (train/val/test)\nL113:     :return:\nL114:     \"\"\"\nL115:     for img_file in tqdm(img_array, total=len(img_array)):\nL116:         overlay_map = overlay_image(img_file, window_size, threshold, output_dens_dir,\nL117:                                     mode=mode,\nL118:                                     overlay_bbox=False, show=False, save_overlay_map=False)\nL119:         result = split_overlay_map(overlay_map)\nL120:         gather_split_result(img_file, result, output_img_dir, output_anno_dir, mode=mode)\n--------------------------------------------------------------------------------\n (https://raw.githubusercontent.com/Cli98/DMNet/master/image%20cropping/plot_utils.py)\nciteturn192view1 [wordlim: 200] Crawled: 2 weeks ago; Content type: text/plain; Source: open({\"ref_id\":\"https://raw.githubusercontent.com/Cli98/DMNet/master/image%20cropping/plot_utils.py\",\"lineno\":null}); Total lines: 92\nL0: import cv2\nL1: import matplotlib.pyplot as plt\nL2: import numpy as np\nL3: import os\nL4: from anno_utils import format_label\nL5: from tqdm import tqdm\nL6: \nL7: def overlay_image(file, window_size, threshold,\nL8:                   output_dir=None, mode=\"train\",\nL9:                   overlay_bbox=False, show=False, save_overlay_map=False):\nL10:     # On 01/17/2020, change input type to single file_path\nL11:     \"\"\"\nL12:     Serve as overlay purpose , will be able to\nL13:         1. overlay images with bbox (via overlay_bbox)\nL14:         2. overlay images with density map\nL15:     :param file: The file to overlay\nL16:     :param window_size: The kernel selected to slide on images to gather crops\nL17:     :param threshold: determine if the crops are ROI, only crop when total pixel sum exceeds threshold\nL18:     :param output_dir: The output dir to save sample image.\nL19:     :param mode: The dataset to work on (Train/val/test)\nL20:     :param overlay_bbox: Whether to overlay bbox on images\nL21:     :param show: Whether to show visualization\nL22:     :param save_overlay_map: Whether to overlay density map with images\nL23:     :return:\nL24:     \"\"\"\nL25:     if save_overlay_map and not output_dir:\nL26:         print(\"please provide name for output folder.\")\nL27:         return\nL28:     w_h, w_w = window_size\nL29:     img = cv2.imread(file)\nL30:     dens = np.load(file.replace(\"images\", \"dens\").replace(\"jpg\", \"npy\"))\nL31:     # Strictly speaking, only train set should have anno to draw bbox,\nL32:     # but since we have train/val/test anno, we only disable test-challenge\nL33:     if mode != \"test-challenge\":\nL34:         # For test-challenge dataset, we have no ground truth and thus cannot access annotations\nL35:         anno_path = file.replace(\"images\", \"annotations\").replace(\"jpg\", \"txt\")\nL36:         coord_list = format_label(anno_path, mode)\nL37:     overlay_map = np.zeros(dens.shape)\nL38:     # print(img.shape, dens.shape)\nL39:     assert img.shape[:-1] == dens.shape, \"Shape mismatch between input image and density map!\"\nL40:     img_height, img_width = img.shape[:-1]\nL41:     for height in range(0, img_height, w_h):\nL42:         if height + w_h > img_height:\nL43:             slide_height = img_height - w_h\nL44:         else:\nL45:             slide_height = height\nL46:         for width in range(0, img_width, w_w):\nL47:             if width + w_w > img_width:\nL48:                 # It's next slide will across boundary, modify end condition\nL49:                 slide_width = img_width - w_w\nL50:             else:\nL51:                 slide_width = width\nL52:             crops = dens[slide_height:slide_height + w_h, slide_width:slide_width + w_w]\nL53:             if crops.sum() >= threshold:\nL54:                 # save crop image\nL55:                 overlay_map[slide_height:slide_height + w_h, slide_width:slide_width + w_w] = 255\nL56:     if overlay_bbox and mode != \"test-challenge\":\nL57:         for bbox in coord_list:\nL58:             cv2.rectangle(img, (bbox[0], bbox[1]), (bbox[2], bbox[3]), (255, 0, 0), 2)\nL59:     if show:\nL60:         plt.imshow(img)\nL61:         plt.imshow(overlay_map, alpha=0.3)\nL62:         plt.axis(\"off\")\nL63:         plt.show()\nL64:     if save_overlay_map:\nL65:         file_name = file.split(\"/\")[-1]\nL66:         # plt.imshow(img)\nL67:         # plt.imshow(overlay_map, alpha=0.7)\nL68:         status = cv2.imwrite(os.path.join(output_dir, file_name), overlay_map)\nL69:         if not status:\nL70:             # check status to see if we successfully save images\nL71:             print(\"Failed to save overlay image\")\nL72:         plt.savefig(os.path.join(output_dir, file_name + '.png'))\nL73:     return overlay_map\nL74: \nL75: def save_overlay_image(img_array, window_size, threshold, output_dens_dir,\nL76:                        mode=\"train\"):\nL77:     \"\"\"\nL78:     For Debug/Visualization purpose only, generate a sample with cropping area indicated\nL79:     :param img_array: The input image to crop on\nL80:     :param window_size: The kernel selected to slide on images to gather crops\nL81:     :param threshold: determine if the crops are ROI, only crop when total pixel sum exceeds threshold\nL82:     :param output_dens_dir: The output dir to save density map\nL83:     :param mode: The dataset to operate on (train/val/test)\nL84:     :return:\nL85:     \"\"\"\nL86:     if not os.path.exists(output_dens_dir):\nL87:         os.makedirs(output_dens_dir)\nL88:     for img_file in tqdm(img_array, total=len(img_array)):\nL89:         overlay_map = overlay_image(img_file, window_size, threshold, output_dens_dir,\nL90:                                     mode=mode,\nL91:                                     overlay_bbox=True, show=False, save_overlay_map=True)\n"

" (https://raw.githubusercontent.com/Cli98/DMNet/master/image%20cropping/density_slide_window_official.py)\nciteturn191view0 [wordlim: 200] Crawled: 2 weeks ago; Content type: text/plain; Source: open({\"ref_id\":\"https://raw.githubusercontent.com/Cli98/DMNet/master/image%20cropping/density_slide_window_official.py\",\"lineno\":null}); Total lines: 80\nL0: from tqdm import tqdm\nL1: import glob\nL2: import os\nL3: import argparse\nL4: from plot_utils import overlay_image\nL5: from density_slide_utils import split_overlay_map, save_cropped_result\nL6: from eval_utils import measure_hit_rate\nL7: \nL8: \"\"\"\nL9: Code for DMnet, density crops generation\nL10: Author: Changlin Li\nL11: Code revised on : 7/16/2020\nL12: Given dataset(train/val/test) generate density crops for given dataset.\nL13: Default format for source data: The input images are in jpg format and raw annotations are in txt format\nL14: (Based on Visiondrone 2018/19/20 dataset)\nL15: \nL16: The data should be arranged in following structure before you call any function within this script:\nL17: dataset(Train/val/test)\nL18: --------images\nL19: --------dens (short for density map)\nL20: --------Annotations (Optional, but not available only when you conduct inference steps)\nL21: Sample running command:\nL22: python density_slide_window_official.py . height_width threshld --output_folder output_folder --mode val\nL23: \"\"\"\nL24: \nL25: def measure_hit_rate_on_data(file_list, window_size, threshold, output_dir, mode=\"train\"):\nL26:     \"\"\"\nL27:     Serve as a function to measure how many bboxs we missed for DMNet. It helps estimate the performance of\nL28:     bounding boxes\nL29:     :param file_list: The annotations file lists to collect\nL30:     :param window_size: The kernel to slide. The size comes from EDA result\nL31:     :param threshold: Determine if current crop is ROI. We keep crops only when the sum > threshold\nL32:     :param output_dir: The output dir to save result\nL33:     :param mode: dataset to use\nL34:     :return:\nL35:     \"\"\"\nL36:     count_data = total_data = 0\nL37:     for file in tqdm(file_list, total=len(file_list)):\nL38:         overlay_map = overlay_image(file, window_size, threshold, output_dir)\nL39:         result = split_overlay_map(overlay_map)\nL40:         count, total = measure_hit_rate(file.replace(\"images\", \"annotations\").replace(\"jpg\", \"txt\"), result,\nL41:                                         mode)\nL42:         count_data += count\nL43:         total_data += total\nL44:     print(\"hit rate is: \" + str(round(count_data / total_data * 100.0, 2)))\nL45: \nL46: def parse_args():\nL47:     parser = argparse.ArgumentParser(\nL48:         description='DMNet--Generate density crops from given density map')\nL49:     parser.add_argument('root_dir', default=\".\",\nL50:                         help='the path for source data')\nL51:     parser.add_argument('window_size', help='The size of kernel, format: h_w')\nL52:     parser.add_argument('threshold', type=float, help='Threshold defined to select the cropped region')\nL53:     parser.add_argument('--image_prefix', default=\".jpg\", help='the path to save precomputed distance')\nL54:     parser.add_argument('--output_folder', help='The dir to save generated images and annotations')\nL55:     parser.add_argument('--mode', default=\"train\", help='Indicate if you are working on train/val/test set')\nL56:     args = parser.parse_args()\nL57:     return args\nL58: \nL59: if __name__ == \"__main__\":\nL60:     # in data folder, val -> original var data+ val density gt\nL61:     # val_mcnn -> mcnn generated data+ mcnn generated density map\nL62:     # to work in mcnn, need to copy generated folder to mcnn\nL63:     # then run two files. Change root to crop_data_mcnn accordingly\nL64:     args = parse_args()\nL65:     mode = args.mode\nL66:     root_dir = args.root_dir\nL67:     folder_name = args.output_folder\nL68:     data_root = mode\nL69:     img_array = glob.glob(f'{root_dir}/{data_root}/images/*.jpg')\nL70:     anno_path = glob.glob(f'{root_dir}/{data_root}/annotations/*.txt')\nL71:     if not os.path.exists(folder_name):\nL72:         os.makedirs(folder_name, exist_ok=False)\nL73:     window_size = args.window_size.split(\"_\")\nL74:     window_size = (int(window_size[0]), int(window_size[1]))\nL75:     threshold = args.threshold\nL76:     output_img_dir, output_anno_dir = os.path.join(folder_name, data_root, \"images\"), \\\nL77:                                       os.path.join(folder_name, data_root, \"annotations\")\nL78:     save_cropped_result(img_array, window_size, threshold, None,\nL79:                         output_img_dir, output_anno_dir, mode=mode)\n"
